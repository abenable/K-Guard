rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function family(fid) { return get(/databases/$(database)/documents/families/$(fid)); }
    function isParent(fid) {
      return signedIn() && request.auth.uid in family(fid).data.parentUids;
    }
    // True when the signed-in user is the child account paired with this child profile.
    function isLinkedChild(fid, cid) {
      return signedIn()
        && get(/databases/$(database)/documents/families/$(fid)/children/$(cid)).data.get('linkedUid', null) == request.auth.uid;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // User profile: owner reads; writes only to non-privileged fields (role/familyId set by Functions).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['displayName', 'fcmTokens']);
      allow update: if signedIn() && request.auth.uid == uid
                    && onlyChanges(['displayName', 'fcmTokens']);
    }

    match /families/{familyId} {
      // Membership and ownership are created by Cloud Functions only.
      allow read: if isParent(familyId);
      allow update: if isParent(familyId)
                    && onlyChanges(['privacy', 'pinHash', 'pinSalt']);
      allow create, delete: if false;

      match /children/{childId} {
        allow read: if isParent(familyId)
                    || (signedIn() && resource.data.linkedUid == request.auth.uid);
        allow create, update: if isParent(familyId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.ageProfile in
               ['KIDS_3_7', 'PRETEENS_8_12', 'TEENS_13_17', 'ADULTS_18_PLUS']
          && (!('linkedUid' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()));
        allow delete: if isParent(familyId);
      }

      // Events are written by Cloud Functions or by the paired child's phone (Live AI). Parents review them.
      match /events/{eventId} {
        allow read: if isParent(familyId);
        allow create: if isLinkedChild(familyId, request.resource.data.childId)
                      && request.resource.data.keys().hasOnly(['childId', 'childName', 'ageProfile', 'contentType',
                           'category', 'riskScore', 'decision', 'context', 'explanation', 'source', 'snippet',
                           'storagePath', 'status', 'createdAt'])
                      && request.resource.data.status == 'open'
                      && request.resource.data.decision in ['ALLOW', 'WARN', 'BLUR', 'BLOCK', 'REVIEW'];
        allow delete: if false;
        allow update: if isParent(familyId)
                      && onlyChanges(['status', 'parentAction', 'parentNote', 'reviewedAt'])
                      && request.resource.data.status in ['open', 'reviewed']
                      && (!('parentAction' in request.resource.data)
                          || request.resource.data.parentAction in ['allow', 'keep_blocked', 'dismiss']);
      }

      // App requests and decisions go through Cloud Functions (so both phones are notified).
      // The paired child's phone reads its own apps to enforce them; parents may change per-app limits.
      match /apps/{appId} {
        allow read: if isParent(familyId)
                    || (signedIn() && resource.data.childLinkedUid == request.auth.uid);
        allow create: if false;
        allow update: if isParent(familyId) && onlyChanges(['dailyLimitMinutes'])
                      && request.resource.data.dailyLimitMinutes is int
                      && request.resource.data.dailyLimitMinutes >= 0 && request.resource.data.dailyLimitMinutes <= 1440;
        allow delete: if isParent(familyId);
      }
      // Small per-app icons (PNG, a few KB) uploaded by the paired child's phone so the parent's
      // app management shows the real icons; the child never reads them back.
      match /appIcons/{appId} {
        allow read: if isParent(familyId);
        allow create, update: if isLinkedChild(familyId, request.resource.data.childId)
                              && request.resource.data.png.size() < 50000;
        allow delete: if isParent(familyId);
      }
      // Install and uninstall history, written by Cloud Functions.
      match /appActivity/{activityId} {
        allow read: if isParent(familyId);
        allow write: if false;
      }
      match /screenTime/{childId} {
        allow read, write: if isParent(familyId);
      }
      // Screen time: the parent writes only the rules; the paired child's phone writes only telemetry.
      // Neither can change the other's fields, so a child cannot raise their own limit.
      match /devices/{childId} {
        function ruleKeys() {
          return ['dailyLimitMinutes', 'bonusMinutes', 'bonusDate', 'bedtimeEnabled', 'bedtimeStart', 'bedtimeEnd',
                  'schoolEnabled', 'schoolStart', 'schoolEnd', 'schoolDays', 'remoteLock', 'overrideUntil',
                  'policyInitialized', 'policyInitializedAt'];
        }
        function changed() {
          return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys();
        }
        allow read: if isParent(familyId) || isLinkedChild(familyId, childId);
        allow create, update: if isParent(familyId) && changed().hasOnly(ruleKeys());
        allow create, update: if isLinkedChild(familyId, childId) && !changed().hasAny(ruleKeys());
        allow delete: if isParent(familyId);

        // Daily usage history from the child's phone.
        match /days/{day} {
          allow read: if isParent(familyId) || isLinkedChild(familyId, childId);
          allow write: if isLinkedChild(familyId, childId);
        }
      }
      // Parent actions and their delivery receipts. The child's phone may only mark them executed.
      match /commands/{commandId} {
        allow read: if isParent(familyId) || isLinkedChild(familyId, resource.data.childId);
        allow create: if isParent(familyId) && request.resource.data.status == 'pending';
        allow update: if isLinkedChild(familyId, resource.data.childId)
                      && onlyChanges(['status', 'executedAt'])
                      && request.resource.data.status in ['executed', 'expired'];
        allow delete: if isParent(familyId);
      }
      // Web protection: the parent sets it; the paired child's phone applies it and reports only its status.
      match /webProtection/{childId} {
        allow read: if isParent(familyId) || isLinkedChild(familyId, childId);
        allow create, update: if isParent(familyId)
                              && (!('device' in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()));
        allow create, update: if isLinkedChild(familyId, childId)
                              && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['device']);
        allow delete: if isParent(familyId);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
